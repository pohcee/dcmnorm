<?xml version="1.0" encoding="UTF-8"?>
<!--
  com.pohcee:dcmnorm: the Java API (src/main/java), with no native code in it. The native
  library (src/lib.rs, a separate Cargo crate built with `cargo build -p dcmnorm-java`) ships in
  com.pohcee:dcmnorm-natives, one jar per platform classifier (natives/pom.xml). Maven never
  invokes Cargo itself: the release workflow builds the library per platform, then packages both.
  Up to 0.13.x these were com.pohcee:dcmnorm-java and com.pohcee:dcmnorm-java-natives; every
  release also publishes relocation POMs under the old names (relocation/).

  The `release` profile adds what Maven Central requires (sources and javadoc jars, GPG
  signatures) and publishes through the Sonatype Central Portal; see the README, "Packaging".
  The version is the dcmnorm release version, written by scripts/release-tag.sh.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>com.pohcee</groupId>
  <artifactId>dcmnorm</artifactId>
  <version>0.20.1</version>
  <packaging>jar</packaging>

  <name>dcmnorm</name>
  <description>Java bindings for dcmnorm: DICOM read/edit/transcode/render and DIMSE networking in-process (JNI). Add com.pohcee:dcmnorm-natives with your platform's classifier.</description>
  <url>https://github.com/pohcee/dcmnorm</url>

  <licenses>
    <license>
      <name>Apache-2.0</name>
      <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
      <distribution>repo</distribution>
    </license>
  </licenses>
  <developers>
    <developer>
      <name>Jason Klotzer</name>
      <url>https://github.com/pohcee</url>
    </developer>
  </developers>
  <scm>
    <connection>scm:git:https://github.com/pohcee/dcmnorm.git</connection>
    <developerConnection>scm:git:git@github.com:pohcee/dcmnorm.git</developerConnection>
    <url>https://github.com/pohcee/dcmnorm</url>
  </scm>
  <issueManagement>
    <system>GitHub</system>
    <url>https://github.com/pohcee/dcmnorm/issues</url>
  </issueManagement>

  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <maven.compiler.release>11</maven.compiler.release>
  </properties>

  <build>
    <resources>
      <resource>
        <directory>src/main/resources</directory>
        <!-- Native libraries live in the natives jars only; a stray local build here must never
             end up in the API jar. -->
        <excludes>
          <exclude>native/**</exclude>
        </excludes>
      </resource>
    </resources>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.13.0</version>
      </plugin>
      <plugin>
        <!-- Smoke.java, NativeLoaderTest.java and LoadCheck.java (src/test/java) have plain
             main()s - like test/smoke.js and test/smoke.py in the other two bindings they are
             standalone scripts, not a JUnit suite, run by build.sh and the release workflow.
             surefire is skipped so `mvn package` doesn't try to run them as JUnit tests. -->
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.2.5</version>
        <configuration>
          <skip>true</skip>
        </configuration>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <profile>
      <id>release</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-source-plugin</artifactId>
            <version>3.3.1</version>
            <executions>
              <execution>
                <id>attach-sources</id>
                <goals>
                  <goal>jar-no-fork</goal>
                </goals>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-javadoc-plugin</artifactId>
            <version>3.11.2</version>
            <configuration>
              <doclint>none</doclint>
              <quiet>true</quiet>
            </configuration>
            <executions>
              <execution>
                <id>attach-javadocs</id>
                <goals>
                  <goal>jar</goal>
                </goals>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <!-- Signs with the key actions/setup-java imported (MAVEN_GPG_PRIVATE_KEY); the
                 passphrase comes from the MAVEN_GPG_PASSPHRASE environment variable. -->
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-gpg-plugin</artifactId>
            <version>3.2.7</version>
            <executions>
              <execution>
                <id>sign-artifacts</id>
                <phase>verify</phase>
                <goals>
                  <goal>sign</goal>
                </goals>
                <configuration>
                  <gpgArguments>
                    <arg>--pinentry-mode</arg>
                    <arg>loopback</arg>
                  </gpgArguments>
                </configuration>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <groupId>org.sonatype.central</groupId>
            <artifactId>central-publishing-maven-plugin</artifactId>
            <version>0.12.0</version>
            <extensions>true</extensions>
            <configuration>
              <publishingServerId>central</publishingServerId>
              <autoPublish>true</autoPublish>
              <waitUntil>published</waitUntil>
              <deploymentName>dcmnorm ${project.version}</deploymentName>
              <!-- The plugin's deferred and staging directories and the bundle default to the
                   first reactor project's target/, and the reactor order of these unrelated
                   modules is not their declaration order: every module names the same place,
                   bindings/java/target/. -->
              <forcedDeferredDirectory>${project.basedir}/target/central-deferred</forcedDeferredDirectory>
              <forcedStagingDirectory>${project.basedir}/target/central-staging</forcedStagingDirectory>
              <forcedOutputDirectory>${project.basedir}/target/central-publishing</forcedOutputDirectory>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
