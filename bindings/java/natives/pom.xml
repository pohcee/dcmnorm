<?xml version="1.0" encoding="UTF-8"?>
<!--
  com.pohcee:dcmnorm-java-natives: the native library of the Java binding, one jar per platform,
  told apart by Maven classifier. A consumer depends on com.pohcee:dcmnorm-java plus exactly one of
  these (see ../README.md, "Install"):

    classifier       jar contents (NativeLoader looks there)
    linux-x86_64     native/linux-x86_64/libdcmnorm_java.so     (+ .sha256)  glibc 2.28+
    linux-aarch_64    native/linux-aarch_64/libdcmnorm_java.so    (+ .sha256)  glibc 2.28+
    osx-aarch_64      native/osx-aarch_64/libdcmnorm_java.dylib   (+ .sha256)  macOS 11+
    osx-x86_64       native/osx-x86_64/libdcmnorm_java.dylib    (+ .sha256)  macOS 10.15+
    windows-x86_64   native/windows-x86_64/dcmnorm_java.dll     (+ .sha256)

  Packaging is pom: the artifact itself is only this POM (no empty main jar, so Central needs no
  sources/javadoc for it), and each platform jar is attached under its classifier. The jars are
  made from ${natives.dir}/<classifier>/, filled by packaging/build-binding-linux.sh (Linux) or
  the release workflow (macOS, Windows); a platform whose directory is missing is skipped, except
  under -Prelease, which requires all five. The version always equals ../pom.xml's.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>com.pohcee</groupId>
  <artifactId>dcmnorm-java-natives</artifactId>
  <version>0.12.0</version>
  <packaging>pom</packaging>

  <name>dcmnorm-java-natives</name>
  <description>Native libraries for dcmnorm-java, one jar per platform classifier: linux-x86_64, linux-aarch_64, osx-aarch_64, osx-x86_64, windows-x86_64.</description>
  <url>https://github.com/pohcee/dcmnorm</url>

  <licenses>
    <license>
      <name>Apache-2.0</name>
      <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
      <distribution>repo</distribution>
    </license>
  </licenses>
  <developers>
    <developer>
      <name>Jason Klotzer</name>
      <url>https://github.com/pohcee</url>
    </developer>
  </developers>
  <scm>
    <connection>scm:git:https://github.com/pohcee/dcmnorm.git</connection>
    <developerConnection>scm:git:git@github.com:pohcee/dcmnorm.git</developerConnection>
    <url>https://github.com/pohcee/dcmnorm</url>
  </scm>

  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <natives.dir>${project.build.directory}/natives</natives.dir>
  </properties>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
        <version>3.4.2</version>
        <configuration>
          <skipIfEmpty>true</skipIfEmpty>
        </configuration>
        <executions>
          <execution>
            <id>linux-x86_64</id>
            <phase>package</phase>
            <goals>
              <goal>jar</goal>
            </goals>
            <configuration>
              <classifier>linux-x86_64</classifier>
              <classesDirectory>${natives.dir}/linux-x86_64</classesDirectory>
            </configuration>
          </execution>
          <execution>
            <id>linux-aarch_64</id>
            <phase>package</phase>
            <goals>
              <goal>jar</goal>
            </goals>
            <configuration>
              <classifier>linux-aarch_64</classifier>
              <classesDirectory>${natives.dir}/linux-aarch_64</classesDirectory>
            </configuration>
          </execution>
          <execution>
            <id>osx-aarch_64</id>
            <phase>package</phase>
            <goals>
              <goal>jar</goal>
            </goals>
            <configuration>
              <classifier>osx-aarch_64</classifier>
              <classesDirectory>${natives.dir}/osx-aarch_64</classesDirectory>
            </configuration>
          </execution>
          <execution>
            <id>osx-x86_64</id>
            <phase>package</phase>
            <goals>
              <goal>jar</goal>
            </goals>
            <configuration>
              <classifier>osx-x86_64</classifier>
              <classesDirectory>${natives.dir}/osx-x86_64</classesDirectory>
            </configuration>
          </execution>
          <execution>
            <id>windows-x86_64</id>
            <phase>package</phase>
            <goals>
              <goal>jar</goal>
            </goals>
            <configuration>
              <classifier>windows-x86_64</classifier>
              <classesDirectory>${natives.dir}/windows-x86_64</classesDirectory>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <profile>
      <id>release</id>
      <!-- A release builds the API (../pom.xml) in the same reactor, so the Central Portal gets both
           artifacts as one bundle: one deployment that is validated and published as a whole,
           never the natives without the API or the other way round. -->
      <modules>
        <module>..</module>
      </modules>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-enforcer-plugin</artifactId>
            <version>3.5.0</version>
            <executions>
              <execution>
                <id>all-platforms</id>
                <phase>validate</phase>
                <goals>
                  <goal>enforce</goal>
                </goals>
                <configuration>
                  <rules>
                    <requireFilesExist>
                      <message>A release publishes every platform's natives jar</message>
                      <files>
                        <file>${natives.dir}/linux-x86_64/native/linux-x86_64/libdcmnorm_java.so</file>
                        <file>${natives.dir}/linux-x86_64/native/linux-x86_64/libdcmnorm_java.so.sha256</file>
                        <file>${natives.dir}/linux-aarch_64/native/linux-aarch_64/libdcmnorm_java.so</file>
                        <file>${natives.dir}/linux-aarch_64/native/linux-aarch_64/libdcmnorm_java.so.sha256</file>
                        <file>${natives.dir}/osx-aarch_64/native/osx-aarch_64/libdcmnorm_java.dylib</file>
                        <file>${natives.dir}/osx-aarch_64/native/osx-aarch_64/libdcmnorm_java.dylib.sha256</file>
                        <file>${natives.dir}/osx-x86_64/native/osx-x86_64/libdcmnorm_java.dylib</file>
                        <file>${natives.dir}/osx-x86_64/native/osx-x86_64/libdcmnorm_java.dylib.sha256</file>
                        <file>${natives.dir}/windows-x86_64/native/windows-x86_64/dcmnorm_java.dll</file>
                        <file>${natives.dir}/windows-x86_64/native/windows-x86_64/dcmnorm_java.dll.sha256</file>
                      </files>
                    </requireFilesExist>
                  </rules>
                </configuration>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <!-- Signs with the key actions/setup-java imported (MAVEN_GPG_PRIVATE_KEY); the
                 passphrase comes from the MAVEN_GPG_PASSPHRASE environment variable. -->
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-gpg-plugin</artifactId>
            <version>3.2.7</version>
            <executions>
              <execution>
                <id>sign-artifacts</id>
                <phase>verify</phase>
                <goals>
                  <goal>sign</goal>
                </goals>
                <configuration>
                  <gpgArguments>
                    <arg>--pinentry-mode</arg>
                    <arg>loopback</arg>
                  </gpgArguments>
                </configuration>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <groupId>org.sonatype.central</groupId>
            <artifactId>central-publishing-maven-plugin</artifactId>
            <version>0.12.0</version>
            <extensions>true</extensions>
            <configuration>
              <publishingServerId>central</publishingServerId>
              <autoPublish>true</autoPublish>
              <waitUntil>published</waitUntil>
              <deploymentName>dcmnorm-java ${project.version}</deploymentName>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
