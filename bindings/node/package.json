{
  "name": "dcmnorm",
  "version": "0.15.1",
  "description": "Native Node.js bindings for dcmnorm: DICOM read/edit/transcode/render and DIMSE networking in-process (no CLI subprocess)",
  "license": "Apache-2.0",
  "author": "Jason Klotzer",
  "homepage": "https://github.com/pohcee/dcmnorm/tree/main/bindings/node#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pohcee/dcmnorm.git",
    "directory": "bindings/node"
  },
  "bugs": {
    "url": "https://github.com/pohcee/dcmnorm/issues"
  },
  "keywords": [
    "dicom",
    "medical-imaging",
    "pacs",
    "dimse",
    "napi-rs"
  ],
  "main": "dcmnorm.js",
  "types": "dcmnorm.d.ts",
  "files": [
    "dcmnorm.js",
    "dcmnorm.d.ts",
    "dicom-constants.js",
    "dicom-constants.d.ts",
    "index.js",
    "index.d.ts"
  ],
  "napi": {
    "binaryName": "dcmnorm-node",
    "targets": [
      "x86_64-unknown-linux-gnu",
      "aarch64-unknown-linux-gnu",
      "x86_64-pc-windows-msvc",
      "aarch64-apple-darwin",
      "x86_64-apple-darwin"
    ]
  },
  "engines": {
    "node": ">= 18"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "napi build --platform --release && node prepare-npm.js --fix-loader",
    "build:debug": "napi build --platform && node prepare-npm.js --fix-loader",
    "build:docker": "./build-in-docker.sh",
    "test": "node test/smoke.js && node test/dataset.js && node test/registration.js"
  },
  "optionalDependencies": {
    "@dcmnorm/linux-x64-gnu": "0.15.1",
    "@dcmnorm/linux-arm64-gnu": "0.15.1",
    "@dcmnorm/win32-x64-msvc": "0.15.1",
    "@dcmnorm/darwin-arm64": "0.15.1",
    "@dcmnorm/darwin-x64": "0.15.1"
  },
  "devDependencies": {
    "@napi-rs/cli": "^3.7.3"
  }
}
