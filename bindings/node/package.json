{
  "name": "@pohcee/dcmnorm-node",
  "version": "0.1.15",
  "private": true,
  "description": "Native Node.js bindings for dcmnorm (in-process, no CLI subprocess)",
  "main": "index.js",
  "types": "index.d.ts",
  "napi": {
    "binaryName": "dcmnorm-node",
    "targets": [
      "x86_64-unknown-linux-gnu",
      "aarch64-unknown-linux-gnu"
    ]
  },
  "engines": {
    "node": ">= 18"
  },
  "scripts": {
    "build": "napi build --platform --release",
    "build:debug": "napi build --platform",
    "build:docker": "./build-in-docker.sh",
    "test": "node test/smoke.js",
    "release": "release-it --ci",
    "release-dryrun": "release-it --verbose --dry-run --ci"
  },
  "release-it": {
    "git": {
      "requireCleanWorkingDir": false,
      "tagName": "dcmnorm-node-v${version}",
      "tagAnnotation": "dcmnorm-node release v${version}"
    },
    "npm": {
      "publish": false
    },
    "hooks": {
      "before:init": "npm run build:docker && npm test"
    }
  },
  "devDependencies": {
    "@napi-rs/cli": "^3.7.3",
    "release-it": "^19.0.4"
  }
}
